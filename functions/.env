# The Google accounts allowed into the dashboard, comma separated. Change it
# here and redeploy (functions/.env.local overrides it for the emulator only).
ALLOWED_EMAILS=warren.s.488@gmail.com,warren.scantlebury@gmail.com

# The AI provider behind the dashboard's "Condense" (server mode). Leave
# AI_PROVIDER empty to run without one: the dashboard still offers a local
# model and copy/paste. Values: "anthropic", or "openai" for any
# OpenAI-compatible endpoint (OpenAI, OpenRouter, Ollama, LM Studio; set
# AI_BASE_URL to its /v1 root). The key lives in Secret Manager, not here:
# `firebase functions:secrets:set AI_API_KEY` (emulator: functions/.secret.local).
AI_PROVIDER=
AI_MODEL=
AI_BASE_URL=
