{
  "name": "project-me",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxi dev",
    "serve": "nuxi dev",
    "build": "nuxi generate",
    "generate": "nuxi generate",
    "preview": "nuxi preview",
    "postinstall": "nuxi prepare",
    "prepare": "simple-git-hooks",
    "lint": "eslint . && prettier --check .",
    "typecheck": "nuxi typecheck",
    "deploy": "nuxi generate && firebase deploy --only hosting,functions,firestore:rules",
    "og:build": "node scripts/build-social-card.js",
    "emulators": "firebase emulators:start --only functions,firestore,auth"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "nuxt": "^4.5.2",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.0.0",
    "sass": "^1.90.0",
    "simple-git-hooks": "^2.13.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,scss,md}": "prettier --write"
  }
}
